msgid "fail_duration enables a passive health check when multiple destinations in \"Upstream Domain\" are set. It is a value that defines how long to remember a failed request. A duration of 1 or more seconds enables passive health checking. A reasonable starting point might be 30s to balance error rates with responsiveness when bringing an unhealthy upstream back online."
msgstr "fail_duration bật kiểm tra sức khỏe thụ động khi có nhiều đích đến được đặt trong \"Upstream Domain\". Đây là giá trị xác định thời gian ghi nhớ một yêu cầu thất bại. Khoảng thời gian 1 giây trở lên sẽ bật kiểm tra sức khỏe thụ động. Một điểm khởi đầu hợp lý có thể là 30 giây để cân bằng tỷ lệ lỗi với khả năng phản hồi khi đưa upstream không khỏe trở lại trực tuyến."

#. File: /usr/lang/src/controllers.php, line: 6408
#: 
msgid "gid"
msgstr "gid"

#. File: /usr/lang/src/controllers.php, line: 6409
#: 
msgid "health_body is a substring or regular expression to match on the response body of an active health check. If the backend does not return a matching body, it will be marked as down."
msgstr "health_body là một chuỗi con hoặc biểu thức chính quy để khớp với phần thân phản hồi của kiểm tra sức khỏe chủ động. Nếu backend không trả về phần thân khớp, nó sẽ được đánh dấu là không hoạt động."

#. File: /usr/lang/src/controllers.php, line: 6410
#: 
msgid "health_fails is the number of consecutive health checks required before marking the backend as unhealthy. Default: 1."
msgstr "health_fails là số lần kiểm tra sức khỏe liên tiếp cần thiết trước khi đánh dấu backend là không khỏe. Mặc định: 1."

#. File: /usr/lang/src/controllers.php, line: 6411
#: 
msgid "health_follow_redirects will cause the health check to follow redirects provided by upstream. By default, a redirect response would cause the health check to count as a fail."
msgstr "health_follow_redirects sẽ khiến kiểm tra sức khỏe đi theo các chuyển hướng do upstream cung cấp. Theo mặc định, một phản hồi chuyển hướng sẽ khiến kiểm tra sức khỏe được tính là thất bại."

#. File: /usr/lang/src/controllers.php, line: 6412
#: 
msgid "health_interval is a duration value that defines how often to perform active health checks. Default: 30s."
msgstr "health_interval là giá trị khoảng thời gian xác định tần suất thực hiện kiểm tra sức khỏe chủ động. Mặc định: 30 giây."

#. File: /usr/lang/src/controllers.php, line: 6413
#: 
msgid "health_passes is the number of consecutive health checks required before marking the backend as healthy again. Default: 1."
msgstr "health_passes là số lần kiểm tra sức khỏe liên tiếp cần thiết trước khi đánh dấu backend là khỏe trở lại. Mặc định: 1."

#. File: /usr/lang/src/controllers.php, line: 6414
#: 
msgid "health_port is the port to use for active health checks, if different from the upstream's port. Ignored if health_upstream is used."
msgstr "health_port là port được sử dụng cho kiểm tra sức khỏe chủ động, nếu khác với port của upstream. Bỏ qua nếu health_upstream được sử dụng."

#. File: /usr/lang/src/controllers.php, line: 6415
#: 
msgid "health_status is the HTTP status code to expect from a healthy backend. Can be a 3-digit status code, or a status code class ending in xx. For example: 200 (which is the default), or 2xx."
msgstr "health_status là mã trạng thái HTTP mong đợi từ một backend khỏe mạnh. Có thể là mã trạng thái 3 chữ số hoặc một lớp mã trạng thái kết thúc bằng xx. Ví dụ: 200 (mặc định), hoặc 2xx."

#. File: /usr/lang/src/controllers.php, line: 6416
#: 
msgid "health_timeout is a duration value that defines how long to wait for a reply before marking the backend as down. Default: 5s."
msgstr "health_timeout là giá trị khoảng thời gian xác định thời gian chờ phản hồi trước khi đánh dấu backend là không hoạt động. Mặc định: 5 giây."

#. File: /usr/lang/src/controllers.php, line: 6417
#: 
msgid "health_upstream is the ip:port to use for active health checks, if different from the upstream. This should be used in tandem with health_header and {http.reverse_proxy.active.target_upstream}"
msgstr "health_upstream là ip:port được sử dụng cho kiểm tra sức khỏe chủ động, nếu khác với upstream. Tùy chọn này nên được sử dụng cùng với health_header và {http.reverse_proxy.active.target_upstream}"

#. File: /usr/lang/src/controllers.php, line: 6418
#: 
msgid "health_uri is the URI path (and optional query) for active health checks."
msgstr "health_uri là đường dẫn URI (và truy vấn tùy chọn) cho kiểm tra sức khỏe chủ động."

#. File: /usr/lang/src/controllers.php, line: 6421
#: 
msgid "http://localhost:9200"
msgstr "http://localhost:9200"

#. File: /usr/lang/src/controllers.php, line: 6422
#: 
msgid "id:api_key"
msgstr "id:api_key"

#. File: /usr/lang/src/controllers.php, line: 6423
#: 
msgid "idle is a duration value in seconds that sets the maximum time to wait for the next request when keep-alives are enabled. Defaults value helps to avoid resource exhaustion."
msgstr "idle là giá trị khoảng thời gian tính bằng giây, đặt thời gian tối đa chờ yêu cầu tiếp theo khi keep-alive được bật. Giá trị mặc định giúp tránh cạn kiệt tài nguyên."

#. File: /usr/lang/src/controllers.php, line: 6430
#: 
msgid "lb_policy is the name of the load balancing policy, along with any options. For policies that involve hashing, the highest-random-weight (HRW) algorithm is used to ensure that a client or request with the same hash key is mapped to the same upstream, even if the list of upstreams change."
msgstr "lb_policy là tên của chính sách cân bằng tải, cùng với bất kỳ tùy chọn nào. Đối với các chính sách liên quan đến hashing, thuật toán highest-random-weight (HRW) được sử dụng để đảm bảo rằng client hoặc yêu cầu có cùng khóa hash được ánh xạ tới cùng một upstream, ngay cả khi danh sách upstream thay đổi."

#. File: /usr/lang/src/controllers.php, line: 6431
#: 
msgid "lb_retries is how many times to retry selecting available backends for each request if the next available host is down. If lb_try_duration is also configured, then retries may stop early if the duration is reached. In other words, the retry duration takes precedence over the retry count."
msgstr "lb_retries là số lần thử lại việc chọn backend khả dụng cho mỗi yêu cầu nếu host khả dụng tiếp theo không hoạt động. Nếu lb_try_duration cũng được cấu hình, thì việc thử lại có thể dừng sớm khi đạt đến khoảng thời gian. Nói cách khác, thời gian thử lại được ưu tiên hơn số lần thử lại."

#. File: /usr/lang/src/controllers.php, line: 6432
#: 
msgid "lb_try_duration is a duration value that defines how long to try selecting available backends for each request if the next available host is down. Clients will wait for up to this long while the load balancer tries to find an available upstream host. A reasonable starting point might be 5s since the HTTP transport's default dial timeout is 3s, so that should allow for at least one retry if the first selected upstream cannot be reached."
msgstr "lb_try_duration là giá trị khoảng thời gian xác định bao lâu để thử chọn backend khả dụng cho mỗi yêu cầu nếu host khả dụng tiếp theo không hoạt động. Client sẽ chờ đến khoảng thời gian này trong khi bộ cân bằng tải cố gắng tìm một host upstream khả dụng. Một điểm khởi đầu hợp lý có thể là 5 giây vì timeout dial mặc định của HTTP transport là 3 giây, do đó nên cho phép ít nhất một lần thử lại nếu upstream được chọn đầu tiên không thể truy cập được."

#. File: /usr/lang/src/controllers.php, line: 6433
#: 
msgid "lb_try_interval is a duration value that defines how long to wait between selecting the next host from the pool. Only relevant when a request to an upstream host fails. Be aware that setting this to 0 with a non-zero lb_try_duration can cause the CPU to spin if all backends are down and latency is very low."
msgstr "lb_try_interval là giá trị khoảng thời gian xác định bao lâu để chờ giữa việc chọn host tiếp theo từ pool. Chỉ liên quan khi yêu cầu tới một host upstream thất bại. Lưu ý rằng đặt giá trị này thành 0 với lb_try_duration khác 0 có thể khiến CPU bị quay nếu tất cả các backend đều không hoạt động và độ trễ rất thấp."

#. File: /usr/lang/src/controllers.php, line: 6448
#: 
msgid "max_fails is the maximum number of failed requests within fail_duration that are needed before considering an upstream to be down."
msgstr "max_fails là số lượng yêu cầu thất bại tối đa trong fail_duration cần thiết trước khi coi một upstream là không hoạt động."

#. File: /usr/lang/src/controllers.php, line: 6452
#: 
msgid "no timout"
msgstr "không có timeout"

#. File: /usr/lang/src/controllers.php, line: 6466
#: 
msgid "propagation_delay is a duration value in seconds that sets how long to wait before starting DNS TXT records propagation checks when using the DNS challenge."
msgstr "propagation_delay là giá trị khoảng thời gian tính bằng giây, đặt thời gian chờ trước khi bắt đầu kiểm tra lan truyền bản ghi DNS TXT khi sử dụng DNS challenge."

#. File: /usr/lang/src/controllers.php, line: 6467
#: 
msgid "propagation_timeout is a duration value in seconds that sets the maximum time to wait for the DNS TXT records to appear when using the DNS challenge."
msgstr "propagation_timeout là giá trị khoảng thời gian tính bằng giây, đặt thời gian tối đa chờ bản ghi DNS TXT xuất hiện khi sử dụng DNS challenge."

#. File: /usr/lang/src/controllers.php, line: 6469
#: 
msgid "read_body is a duration value in seconds that sets how long to allow a read from a client's upload. Setting this to a short, non-zero value can mitigate slowloris attacks, but may also affect legitimately slow clients."
msgstr "read_body là giá trị khoảng thời gian tính bằng giây, đặt thời gian cho phép đọc từ nội dung upload của client. Đặt giá trị này thành một giá trị ngắn, khác 0 có thể giảm thiểu các cuộc tấn công slowloris, nhưng cũng có thể ảnh hưởng đến các client chậm hợp pháp."

#. File: /usr/lang/src/controllers.php, line: 6470
#: 
msgid "read_header is a duration value in seconds that sets how long to allow a read from a client's request headers."
msgstr "read_header là giá trị khoảng thời gian tính bằng giây, đặt thời gian cho phép đọc từ header yêu cầu của client."

#. File: /usr/lang/src/controllers.php, line: 6475
#: 
msgid "scaleway"
msgstr "scaleway"

#. File: /usr/lang/src/controllers.php, line: 6485
#: 
msgid "uid"
msgstr "uid"

#. File: /usr/lang/src/controllers.php, line: 6486
#: 
msgid "unhealthy_latency is a duration value in ms that counts a request as failed if it takes this long to get a response."
msgstr "unhealthy_latency là giá trị khoảng thời gian tính bằng mili giây, sẽ tính một yêu cầu là thất bại nếu mất thời gian này để nhận phản hồi."

#. File: /usr/lang/src/controllers.php, line: 6487
#: 
msgid "unhealthy_request_count is the permissible number of simultaneous requests to a backend before marking it as down. In other words, if a particular backend is currently handling this many requests, then it is considered \"overloaded\" and other backends will be preferred instead. This should be a reasonably large number; configuring this means that the proxy will have a limit of unhealthy_request_count × upstreams_count total simultaneous requests, and any requests after that point will result in an error due to no upstreams being available."
msgstr "unhealthy_request_count là số yêu cầu đồng thời cho phép tới một backend trước khi đánh dấu nó là không hoạt động. Nói cách khác, nếu một backend cụ thể đang xử lý số lượng yêu cầu này, thì nó được coi là \"quá tải\" và các backend khác sẽ được ưu tiên thay thế. Đây nên là một số khá lớn; cấu hình giá trị này có nghĩa là proxy sẽ có giới hạn unhealthy_request_count × upstreams_count tổng yêu cầu đồng thời, và bất kỳ yêu cầu nào sau điểm đó sẽ dẫn đến lỗi do không có upstream khả dụng."

#. File: /usr/lang/src/controllers.php, line: 6488
#: 
msgid "unhealthy_status counts a request as failed if the response comes back with one of these status codes. Can be a 3-digit status code or a status code class ending in xx, for example: 404 or 5xx."
msgstr "unhealthy_status tính một yêu cầu là thất bại nếu phản hồi trả về với một trong các mã trạng thái này. Có thể là mã trạng thái 3 chữ số hoặc lớp mã trạng thái kết thúc bằng xx, ví dụ: 404 hoặc 5xx."

#. File: /usr/lang/src/controllers.php, line: 6492
#: 
msgid "write is a duration value in seconds that sets how long to allow a write to a client. Note that setting this to a small value when serving large files may negatively affect legitimately slow clients."
msgstr "write là giá trị khoảng thời gian tính bằng giây, đặt thời gian cho phép ghi tới một client. Lưu ý rằng đặt giá trị này nhỏ khi phục vụ các tệp lớn có thể ảnh hưởng tiêu cực đến các client chậm hợp pháp."

