#. File: /usr/lang/src/controllers.php, line: 3373
#: 
msgid "Limits Dnsmasq to the specified maximum number of DHCP leases. This limit is to prevent DoS attacks from hosts which create thousands of leases and use lots of memory in the Dnsmasq process."
msgstr "Giới hạn Dnsmasq ở số lượng DHCP lease tối đa được chỉ định. Giới hạn này nhằm ngăn chặn các cuộc tấn công DoS từ các host tạo hàng nghìn lease và sử dụng nhiều bộ nhớ trong tiến trình Dnsmasq."

#. File: /usr/lang/src/controllers.php, line: 3374
#: 
msgid "Limits disk access by setting a maximum I/O rate in swaps per second (default 0 = disable when left empty)."
msgstr "Giới hạn truy cập đĩa bằng cách đặt tốc độ I/O tối đa tính theo số swap mỗi giây (mặc định 0 = tắt khi để trống)."

#. File: /usr/lang/src/controllers.php, line: 3375
