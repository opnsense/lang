#: 
msgid "%s1%s -- startup info + connection initiated messages + non-fatal encryption & net errors."
msgstr "%s1%s -- 啟動資訊 + 連線啟始訊息 + 非重大加密和網路錯誤。"

#. File: /usr/core/src/www/vpn_openvpn_server.php, line: 1563
#: 
